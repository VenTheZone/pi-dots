{
  "cacheTtlHours": 12,
  "providers": {
    "openrouter": {
      "enabled": true,
      "apiKey": "OPENROUTER_API_KEY"
    },
    "kilo-gateway": {
      "enabled": true,
      "displayName": "Kilo Gateway",
      "kind": "openai-compatible",
      "api": "openai-completions",
      "baseUrl": "https://api.kilo.ai/api/gateway/v1",
      "modelsUrl": "https://api.kilo.ai/api/gateway/models",
      "apiKey": "!node -e \"const{readFileSync}=require('fs'),{homedir}=require('os');const d=JSON.parse(readFileSync(homedir()+'/.pi/agent/auth.json'));process.stdout.write((d['kilo-gateway']||{}).access||'')\"",
      "authHeader": true,
      "defaultContextWindow": 131072,
      "defaultMaxTokens": 16384,
      "defaultReasoning": true,
      "include": [
        "*:free",
        "kilo-auto/free"
      ],
      "maxModels": 200,
      "modelOverrides": {
        "kilo-auto/free": {
          "name": "Kilo Auto Free (auto-routes to cheapest free model)",
          "contextWindow": 131072,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      }
    },
    "agentrouter": {
      "enabled": true,
      "displayName": "AgentRouter (Claude)",
      "api": "anthropic-messages",
      "baseUrl": "https://agentrouter.org",
      "apiKey": "!node -e \"const{readFileSync}=require('fs'),{homedir}=require('os');const f=homedir()+'/.pi/agent/models.json';process.stdout.write(process.env.AGENTROUTER_API_KEY||JSON.parse(readFileSync(f)).providers.agentrouter.apiKey||'')\"",
      "models": [
        {
          "id": "claude-opus-4-8",
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "contextWindow": 200000,
          "maxTokens": 32000
        },
        {
          "id": "claude-opus-5",
          "name": "Claude Opus 5",
          "reasoning": true,
          "contextWindow": 200000,
          "maxTokens": 32000
        }
      ]
    },
    "agentrouter-openai": {
      "enabled": true,
      "displayName": "AgentRouter (OpenAI)",
      "api": "openai-completions",
      "baseUrl": "https://agentrouter.org/v1",
      "apiKey": "!node -e \"const{readFileSync}=require('fs'),{homedir}=require('os');const f=homedir()+'/.pi/agent/models.json';process.stdout.write(process.env.AGENTROUTER_API_KEY||JSON.parse(readFileSync(f)).providers.agentrouter.apiKey||'')\"",
      "models": [
        {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "contextWindow": 128000,
          "maxTokens": 32768
        }
      ]
    }
  }
}